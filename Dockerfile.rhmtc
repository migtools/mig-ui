#@follow_tag(registry.redhat.io/ubi8/nodejs-16:latest)
FROM registry.redhat.io/ubi8/nodejs-16:latest AS builder

# Copy application source
COPY --chown=1001:0 . $APP_ROOT/src

# Set up working directory
WORKDIR $APP_ROOT/src

# Copy Hermeto-generated package tarballs to .yarn-cache
# This is the correct location for the offline mirror
#COPY --chown=1001:0 /cachi2/output/deps/yarn-classic $APP_ROOT/src/.yarn-cache

# Add any additional files needed from the build context
COPY . .

USER root

# Install build dependencies
RUN dnf install -y openssl-devel python3
RUN dnf module install -y nodejs:16/development

# Install Yarn globally (ensure this tarball exists in your context)
RUN container-entrypoint npm config set offline true
RUN container-entrypoint npm install --no-audit --verbose -g ./third-party/yarn-v1.22.22.tar.gz

# Configure Yarn for offline use
RUN yarn config set nodedir /usr
#RUN yarn config set yarn-offline-mirror $APP_ROOT/src/.yarn-cache
RUN yarn config set yarn-offline-mirror /cachi2/output/deps/yarn-classic
RUN yarn config set yarn-offline-mirror-pruning false

# Set environment variables for build
ENV BRAND_TYPE="RedHat"
ENV CHROMEDRIVER_SKIP_DOWNLOAD=true \
    SKIP_SASS_BINARY_DOWNLOAD_FOR_CI=true \
    CYPRESS_INSTALL_BINARY=0

# Install dependencies from offline cache
# This will extract the tarballs from .yarn-cache into node_modules
RUN container-entrypoint yarn install --offline

# Build the application
RUN container-entrypoint bash -c 'BRAND_TYPE=RedHat yarn build'

# Optionally install production dependencies only
RUN container-entrypoint yarn install --offline --production

# Clean up
RUN rm -rf $REMOTE_SOURCE_DIR

#@follow_tag(registry.redhat.io/ubi8/nodejs-16-minimal:latest)
FROM registry.redhat.io/ubi8/nodejs-16-minimal:latest
USER 1001
COPY --from=builder $APP_ROOT/src/dist /opt/app-root/src/staticroot
COPY --from=builder $APP_ROOT/src/public/favicon.ico /opt/app-root/src/staticroot
COPY --from=builder $APP_ROOT/src/public/index.ejs /opt/app-root/src/staticroot
COPY --from=builder $APP_ROOT/src/deploy/main.js /opt/app-root/src
COPY --from=builder $APP_ROOT/src/node_modules /opt/app-root/src/node_modules

ENV MIGMETA_FILE="/etc/mig-ui/migmeta.json"
ENV VIEWS_DIR=/opt/app-root/src/staticroot
ENV STATIC_DIR=/opt/app-root/src/staticroot
ENV NODE_TLS_REJECT_UNAUTHORIZED="0"
ENV BRAND_TYPE="RedHat"
USER 65534:65534
ENTRYPOINT ["node", "/opt/app-root/src/main.js"]

LABEL \
        com.redhat.component="openshift-migration-ui-container" \
        version="v1.8.8" \
        name="rhmtc/openshift-migration-ui-rhel8" \
        summary="Migration Toolkit for Containers UI" \
        maintainer="Migration Team <ocp-migrate-team@redhat.com>" \
        License="ASL 2.0" \
        io.k8s.display-name="Migration Toolkit for Containers" \
        io.openshift.tags="migration" \
        io.k8s.description="Migration Toolkit for Containers UI" \
        io.openshift.build.commit.id="e9d51506c126de75e7e5474b416dcaaac9e4677c" \
        io.openshift.build.source-location="https://github.com/migtools/mig-ui" \
        io.openshift.build.commit.url="https://github.com/migtools/mig-ui/commit/e9d51506c126de75e7e5474b416dcaaac9e4677c"
